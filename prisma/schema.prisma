generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  admin
  club
  brand
  solucion
  hincha
  auditor
  manager
}

enum ESGCategory {
  huella_hidrica
  huella_carbono
  gestion_residuos
  educacion
  inclusion
  equidad_genero
}

enum ProjectStatus {
  planning
  in_progress
  completed
  paused
}

enum EventStatus {
  open
  negotiating
  funded
  closed
}

// ─── Models ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(club)
  avatar       String?
  country      String?
  sport        String?
  /// For brand/solution accounts: organization name (clubs use the Club relation).
  org          String?
  demo         Boolean  @default(false)
  notificationPrefs Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club   Club?   @relation(fields: [clubId], references: [id])
  clubId String?

  brandConfig  BrandConfig?
  fanProfile   FanProfile?
  clubEvents   ClubEvent[]
  brandProjects BrandProject[]
  sponsorLeads SponsorLead[]
  notifications Notification[]
  sponsorRequests  SponsorRequest[]  @relation("sponsorRequests")
  solutionContacts SolutionContact[] @relation("solutionContacts")
}

model Club {
  id            String  @id @default(cuid())
  name          String
  sport         String
  country       String
  flag          String
  logo          String?
  esgScore      Float   @default(0)
  ranking       Int     @default(0)
  environmental Float   @default(0)
  social        Float   @default(0)
  governance    Float   @default(0)
  transparency  Float   @default(0)
  members       Int     @default(0)
  founded       Int
  description   String?
  demo          Boolean @default(false)
  /// Puntajes base (sin bonus de proyectos) — el score visible = base + bonus recalculado en servidor.
  baseEnvironmental Float?
  baseSocial        Float?
  baseGovernance    Float?
  /// Ranking del período anterior, para mostrar el Δ real.
  previousRanking Int?
  banner        String?
  region        String?
  website       String?
  createdAt     DateTime @default(now())
  /// Per-club Fan Zone configuration (custom actions / rewards). Null = default set.
  fanActions    Json?
  fanRewards    Json?

  users       User[]
  esgProjects ESGProject[]
  events      Event[]
  kpis        Kpi[]
  documents   Document[]
  fanProfiles FanProfile[]
  strategies  EsgStrategy[]
}

model ESGProject {
  id          String        @id @default(cuid())
  title       String
  category    ESGCategory
  status      ProjectStatus @default(planning)
  progress    Int           @default(0)
  budget      Float
  spent       Float         @default(0)
  startDate   DateTime
  endDate     DateTime
  responsible String
  description String
  /// Nested milestones and project-level KPIs (fidelity with the UI shape).
  milestones  Json?
  kpis        Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubId String

  /// Origen: meta de la Estrategia ESG que materializó este proyecto.
  challenge   StrategyChallenge? @relation(fields: [challengeId], references: [id])
  challengeId String?
}

/// Club-level ESG KPIs (the KPIs & Performance page).
model Kpi {
  id          String   @id @default(cuid())
  name        String
  category    String
  current     Float
  target      Float
  unit        String
  trend       String   @default("up")
  color       String   @default("#10B981")
  icon        String   @default("📊")
  description String   @default("")
  createdAt   DateTime @default(now())

  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubId String
}

model Document {
  id         String   @id @default(cuid())
  name       String
  type       String
  category   String
  size       String
  version    String   @default("v1.0")
  uploadedBy String
  uploadedById String?
  storageKey String?
  mimeType   String?
  uploadedAt DateTime @default(now())

  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubId String
}

/// Public marketplace catalog of high-impact events.
model Event {
  id                String      @id @default(cuid())
  title             String
  clubName          String
  country           String
  flag              String
  sport             String
  category          ESGCategory
  image             String
  description       String
  sustainableImpact String
  budget            Float
  funded            Float       @default(0)
  daysLeft          Int
  sponsoredBy       String[]
  mediaPartner      String?
  sealEsg           Boolean     @default(false)
  featured          Boolean     @default(false)
  audience          Int         @default(0)
  status            EventStatus @default(open)
  /// Seeded showcase data — hidden from real (non-demo) accounts.
  demo              Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  club   Club?   @relation(fields: [clubId], references: [id])
  clubId String?
}

/// Events organized/managed by a user (the "Mis Eventos" page).
model ClubEvent {
  id                String   @id @default(cuid())
  title             String
  date              String
  location          String
  sport             String
  role              String   @default("Organizador")
  sponsorLogo       String?
  mediaPartnerLogo  String?
  esgObjectives     String[]
  status            String   @default("upcoming")
  participants      Int      @default(0)
  description       String   @default("")
  createdAt         DateTime @default(now())

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String
}

/// Sponsorship projects managed by a brand (the brands/projects page).
model BrandProject {
  id          String   @id @default(cuid())
  brand       String
  project     String
  status      String   @default("Propuesta")
  investment  Float    @default(0)
  reach       Int      @default(0)
  esgScore    Int      @default(0)
  category    String
  progress    Int      @default(0)
  description String   @default("")
  createdAt   DateTime @default(now())

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String
}

/// Sponsorship pipeline leads (esg/budget sponsorship tab).
model SponsorLead {
  id        String   @id @default(cuid())
  brand     String
  category  String
  amount    Float    @default(0)
  stage     String   @default("Sin contacto")
  color     String   @default("#94A3B8")
  createdAt DateTime @default(now())

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String
}

model SolutionProvider {
  id                  String   @id @default(cuid())
  name                String
  logo                String?
  initials            String
  color               String
  category            String
  country             String
  flag                String
  description         String
  services            String[]
  projectsCount       Int      @default(0)
  associatedBrand     String?
  associatedBrandLogo String?
  associatedClub      String?
  associatedClubLogo  String?
  stars               Int      @default(5)
  verified            Boolean  @default(false)
  featured            Boolean  @default(false)
  tags                String[]
  website             String?
  isEmpresaB          Boolean  @default(false)
  /// Seeded showcase data — hidden from real (non-demo) accounts.
  demo                Boolean  @default(false)
}

/// A brand's sponsorship configuration (onboarding + brands/config).
model BrandConfig {
  id              String   @id @default(cuid())
  brandName       String   @default("")
  industry        String   @default("")
  country         String   @default("")
  website         String   @default("")
  objectives      String[]
  sponsorshipName String   @default("")
  sponsorshipType String   @default("")
  startDate       String   @default("")
  endDate         String   @default("")
  budget          String   @default("")
  territory       String   @default("")
  sports          String[]
  dataSources     String[]
  kpis            Json?
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
}

/// A hincha's Fan Zone profile and progress.
model FanProfile {
  id                 String   @id @default(cuid())
  points             Int      @default(0)
  tier               String   @default("bronce")
  badgesEarned       Int      @default(0)
  completedActionIds String[]
  claimedRewardIds   String[]
  joinedAt           DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  club   Club?   @relation(fields: [clubId], references: [id])
  clubId String?
}

model Notification {
  id        String   @id @default(cuid())
  type      String   @default("info")
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

// ─── Motor IA · Estrategia ESG ───────────────────────────

enum StrategyStatus {
  draft
  generated
  active
  archived
}

enum EsgPillar {
  ambiental
  social
  gobernanza
}

/// Nivel de madurez de datos del club sobre un desafío (determina cómo se redacta la meta).
enum DataMaturity {
  con_linea_base
  con_diagnostico
  sin_datos
}

model EsgStrategy {
  id              String         @id @default(cuid())
  status          StrategyStatus @default(draft)
  version         Int            @default(1)
  /// Último paso completado (0-6) para retomar el borrador donde quedó.
  currentStep     Int            @default(0)

  // Paso 1 — datos generales y vigencia
  orgName         String         @default("")
  sport           String         @default("")
  orgType         String         @default("")
  vigenciaInicio  Int?
  vigenciaFin     Int?
  respName        String         @default("")
  respRole        String         @default("")
  respEmail       String         @default("")
  isFirstStrategy Boolean        @default(true)

  // Paso 4 — objetivos estratégicos (ordenados por prioridad)
  objectives      String[]

  // Paso 5 — alineación con organismo global del deporte
  alignGlobal     Boolean        @default(false)
  globalBody      String?

  // Paso 6 — contexto adicional libre
  additionalContext String       @default("")

  /// Mejora #8 — periodicidad de revisión de la estrategia.
  reviewFrequency String         @default("anual")

  /// Mejora #2 — ESG Maturity Score por pilar, calculado del Paso 2.
  maturityScores  Json?
  /// Documento generado (JSON estructurado → se renderiza a HTML/PDF).
  generatedDoc    Json?
  generatedAt     DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  club       Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubId     String
  challenges StrategyChallenge[]

  @@index([clubId])
}

model StrategyChallenge {
  id          String       @id @default(cuid())
  pillar      EsgPillar
  /// Clave del catálogo (o "otro" cuando el club lo escribe).
  key         String
  label       String
  isCustom    Boolean      @default(false)

  // Paso 2 — diagnóstico
  hasBaseline    Boolean   @default(false)
  hasDiagnosis   Boolean   @default(false)
  hasHistorical  Boolean   @default(false)
  maturity       DataMaturity @default(sin_datos)

  // Paso 3 — meta, GRI, presupuesto, RR.HH.
  griStandard    String    @default("")
  griTitle       String    @default("")
  indicators     String[]
  sdgs           String[]
  goalText       String    @default("")
  /// Mejora #6 — meta sin línea base se marca preliminar.
  goalPreliminary Boolean  @default(true)
  milestones     Json?
  budgetStatus   String    @default("no")
  budgetAmount   Float?
  budgetCurrency String    @default("CLP")
  budgetPeriod   String    @default("total")
  hrStatus       String    @default("no")
  hrNote         String    @default("")
  proposedProjects Json?

  createdAt   DateTime     @default(now())

  strategy   EsgStrategy         @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  strategyId String
  documents  StrategyDocument[]
  /// Proyectos ESG materializados desde esta meta (cadena estrategia → proyecto → ranking).
  projects   ESGProject[]

  @@index([strategyId])
}

model StrategyDocument {
  id          String   @id @default(cuid())
  name        String
  type        String
  size        String   @default("")
  storageKey  String?
  mimeType    String?
  uploadedAt  DateTime @default(now())

  challenge   StrategyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String

  @@index([challengeId])
}

/// Anexo A — mapeo Desafío → estándar GRI. Tabla de configuración editable en backend.
model GriMapping {
  id           String    @id @default(cuid())
  pillar       EsgPillar
  key          String    @unique
  label        String
  griStandard  String
  griTitle     String
  indicators   String[]
  /// Mejora #4 — ODS vinculados al estándar.
  sdgs         String[]
  /// Unidad y verbo sugeridos para redactar la meta SMART.
  metricUnit   String    @default("")
  metricVerb   String    @default("reducir")
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
}

/// Anexo B — lineamientos ESG globales por deporte. Tabla de configuración editable.
model SportFramework {
  id          String  @id @default(cuid())
  sport       String  @unique
  organism    String
  framework   String
  summary     String  @default("")
  active      Boolean @default(true)
}

/// Solicitud de patrocinio desde el marketplace (marca → evento/club).
model SponsorRequest {
  id        String   @id @default(cuid())
  eventId   String
  message   String   @default("")
  amount    Float?
  status    String   @default("pending")
  createdAt DateTime @default(now())

  requester   User   @relation("sponsorRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String

  @@index([eventId])
}

/// Contacto a un proveedor de soluciones desde el directorio.
model SolutionContact {
  id         String   @id @default(cuid())
  providerId String
  message    String   @default("")
  createdAt  DateTime @default(now())

  requester   User   @relation("solutionContacts", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String

  @@index([providerId])
}

/// Historial de valores de un KPI (para tendencia y evolución reales).
model KpiHistory {
  id         String   @id @default(cuid())
  kpiId      String
  value      Float
  recordedAt DateTime @default(now())

  @@index([kpiId])
}
