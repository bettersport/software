DATABASE_URL=postgresql://user:password@host:port/db
AUTH_SECRET=generate-with-crypto-randomBytes-32-base64url
ANTHROPIC_API_KEY=sk-ant-...   # opcional: activa Claude en Motor IA (generación + Better Agent)
NEXT_PUBLIC_ENABLE_DEMO=false   # true solo en entornos de demo: muestra el panel de acceso rápido con cuentas demo
ANTHROPIC_MODEL=claude-sonnet-5   # opcional
ANTHROPIC_AGENT_MODEL=claude-sonnet-5   # opcional (modelo del Better Agent)
